{
  "name": "truth-dare",
  "private": true,
  "description": "Forward scripts into the Next.js app in truth-dare-web/",
  "scripts": {
    "install": "npm install --prefix ./truth-dare-web",
    "dev": "npm run dev --prefix ./truth-dare-web",
    "build": "npm install --prefix ./truth-dare-web && npm run build --prefix ./truth-dare-web",
    "start": "npm run start --prefix ./truth-dare-web",
    "lint": "npm run lint --prefix ./truth-dare-web"
  }
}
